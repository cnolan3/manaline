Card(
    name: "Overrun",
    cost: "{2}{G}{G}{G}",
    types: [Sorcery],
    text: "Creatures you control get +3/+3 and gain trample until end of turn.",
    spell: Spell(effects: [ModifyPt(target: Each(And([Creature, ControlledBy(You)])), power: Const(3), toughness: Const(3), keywords: [Trample], until: EndOfTurn)]),
)
