Card(
    name: "Pyrotechnics",
    cost: "{4}{R}",
    types: [Sorcery],
    text: "Pyrotechnics deals 4 damage divided as you choose among any number of targets.",
    spell: Spell(
        targets: [Targets(AnyNumber, Any)],
        effects: [DealDamage(amount: Const(4), to: Target(0), divided: true)],
    ),
)
