Card(
    name: "Black Cat",
    cost: "{1}{B}",
    types: [Creature],
    subtypes: ["Zombie", "Cat"],
    pt: (1, 1),
    text: "When this creature dies, target opponent discards a card at random.",
    triggers: [Trigger(event: ThisDies, targets: [Opponent], effects: [Discard(player: TargetOpponent(0), count: Const(1), random: true)])],
)
