// Multiplayer free-for-all with the starter cube: 2–6 seats, 20 life, no extra rules.
// Used by `manaline sim --seats N` and the N-seat property tests.
Format(
    name: "Free-for-All",
    players: (min: 2, max: 6),
    starting_life: 20,
    starting_hand: 7,
    mulligan: London(free_first: false),
    deck: Deck(size: Range(40, 60), singleton: false, includes_commander: false, max_copies: Some(4)),
    rules: [],
    legality: Legality(pool: Builtin("core"), banned: [], allowed: []),
)
